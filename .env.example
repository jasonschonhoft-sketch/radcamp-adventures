# Copy this file to .env.local and fill in your key.
# Get a key at: https://console.cloud.google.com
# Enable: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-side key for AI trail descriptions (api/trail-description.js).
# NOT prefixed with VITE_ — it must never reach the browser bundle.
# Get a key at: https://console.anthropic.com
# Set this in Vercel project settings (Production/Preview/Development) too.
# Local /api functions only run under `vercel dev`, not plain `npm run dev`.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
